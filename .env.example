# Chave da API da Anthropic (console.anthropic.com), nunca versione a chave real
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Google Places API (New) - opcional, mas recomendada.
# Sem essa chave, o app usa IA com busca na web (estimativa).
# Com essa chave, o app usa dados reais do Google (avaliações, nota, concorrentes)
# e libera a análise de posição por raio de distância (1km, 2km, 3km).
# Crie em console.cloud.google.com, ative "Places API (New)" e gere uma chave restrita a ela.
GOOGLE_PLACES_API_KEY=

